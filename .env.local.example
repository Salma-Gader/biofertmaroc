# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored — never commit real credentials.
# This file (.env.local.example) IS committed to git — never put real
# values here, only placeholders.

# Your store's *.myshopify.com domain (no https://, no trailing slash).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token from your app's Storefront API configuration.
# Server-only — this must NEVER be exposed to the browser.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token

# Same domain as above, but safe to expose to the browser (used for things
# like building absolute image/asset URLs on the client if ever needed).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Absolute production URL of this site (no trailing slash) — used to build
# canonical URLs, hreflang alternates, and the sitemap. Falls back to
# http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=https://www.biofertmaroc.com

# ---------------------------------------------------------------------------
# MIGRATION ONLY — never read by the Next.js app itself, only by the
# standalone scripts in scripts/shopify-migration/. Dev Dashboard apps
# don't hand out a static Admin API token to copy/paste; instead these two
# values are exchanged for a short-lived Admin API access token via OAuth
# 2.0 Client Credentials Grant (scripts/shopify-migration/admin-client.ts
# does this automatically — you never handle the token itself).
#
# Find these in the Shopify Dev Dashboard → your app → Client credentials.
# SHOPIFY_CLIENT_SECRET is as sensitive as a password — never prefix either
# of these with NEXT_PUBLIC_, never reference them from app/ or components/.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# ---------------------------------------------------------------------------
# WEBHOOK CACHE INVALIDATION — read by app/api/webhooks/shopify/route.ts
# (server-only). Verifies the X-Shopify-Hmac-Sha256 header on incoming
# webhook requests; never prefix with NEXT_PUBLIC_.
#
# Shopify Admin → Settings → Notifications → Webhooks → "Webhook signing
# secret" (create the section's first webhook if none exists yet). See
# README.md's "Shopify webhook cache invalidation" section for full setup
# steps and the topics to subscribe.
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
